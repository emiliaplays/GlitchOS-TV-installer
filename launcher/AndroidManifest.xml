<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.glitchos.tv" android:versionCode="10" android:versionName="1.4.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <package android:name="com.homwee.mmp.screenshare" />
        <package android:name="com.glitchos.airplayrepair" />
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
    </queries>
    <application android:label="GlitchOS TV Edition" android:icon="@drawable/app_icon" android:banner="@drawable/app_banner" android:theme="@style/AppTheme" android:allowBackup="true" android:supportsRtl="true" android:hardwareAccelerated="true">
        <service android:name=".MediaAccessService" android:label="GlitchOS media controls" android:exported="true" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
            <meta-data android:name="android.service.notification.default_filter_types" android:value="" />
            <meta-data android:name="android.service.notification.disabled_filter_types" android:value="conversations|alerting|silent|ongoing" />
        </service>
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" android:screenOrientation="landscape" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" android:excludeFromRecents="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".HomeRedirectService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true" android:label="GlitchOS Home button">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_redirect" />
        </service>
    </application>
</manifest>
